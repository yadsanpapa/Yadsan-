local function getCharacterByName(nameQuery)
    local cleanName = string.match(nameQuery, "^%s*(.-)%s*$"):lower()
    for _, plr in ipairs(Players:GetPlayers()) do
        if string.sub(plr.Name:lower(), 1, #cleanName) == cleanName or string.sub(plr.DisplayName:lower(), 1, #cleanName) == cleanName then
            return plr.Character
        end
    end
    return nil
end

